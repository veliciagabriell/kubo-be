# KUBO API
PORT=3001
DB_PATH=kubo.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Document Intelligence
# Local Docker Compose exposes the adapter on port 8000.
DOCUMENT_INTELLIGENCE_URL=http://localhost:8000
DOCUMENT_INTELLIGENCE_TIMEOUT_MS=300000

# Optional. Without Redis, document jobs use a non-durable in-process fallback.
REDIS_URL=redis://localhost:6379/0
DOCUMENT_WORKER_CONCURRENCY=2

# Optional existing integrations
AISSTREAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

JWT_SECRET=kubo-super-secret-key-change-in-production-2024
JWT_EXPIRES_IN=7d
DB_PATH=kubo.db
PORT=3001

# Free API key from https://aisstream.io — required for live AIS ship tracking.
# Without it the vessels module logs a warning and simply skips connecting (app still runs).
AISSTREAM_API_KEY=99779e46e62bde42cf6dad4ea998bd7b235b4093

# Free API key from https://aistudio.google.com/apikey (no credit card) — enables the AI
# re-ranking layer in Smart Container Matching via Google Gemini, at no cost. Preferred over
# ANTHROPIC_API_KEY below (checked first). Without any AI key, matching falls back to the
# real-data MCDA score only (app still runs).
GEMINI_API_KEY=AQ.Ab8RN6LW4CvVTaWapvquVMS1zQLCMX809Ee8TjJVZpL-FRZsxA
# Optional: override the default model (gemini-flash-latest) used for AI re-ranking.
GEMINI_MODEL=

# Optional alternative to GEMINI_API_KEY — only used if GEMINI_API_KEY is not set. Claude API
# access is paid (usage-based), unlike the free Gemini tier above.
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-opus-5) used for AI re-ranking.
ANTHROPIC_MODEL=
