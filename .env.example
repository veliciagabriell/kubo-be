# KUBO API
APP_ENV=development
PORT=3001
DB_PATH=kubo.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Document Intelligence
# Local Docker Compose exposes the adapter on port 8000.
DOCUMENT_INTELLIGENCE_URL=http://localhost:8000
DOCUMENT_INTELLIGENCE_TIMEOUT_MS=300000

# Optional. Without Redis, document jobs use a non-durable in-process fallback.
REDIS_URL=redis://localhost:6379/0
DOCUMENT_WORKER_CONCURRENCY=2

# Live vessel tracking. Keep secrets only in .env; never commit real keys here.
AISSTREAM_API_KEY=
AISSTREAM_WATCHDOG_TIMEOUT_MS=60000
AISSTREAM_RATE_LIMIT_COOLDOWN_MS=300000

# Development-only fallback. Requires APP_ENV=development or test.
# Creates clearly-labelled, non-AIS candidates for matching/order/document/OCR testing.
MATCHING_FIXTURE_ENABLED=false
MATCHING_FIXTURE_DEPARTURE_DAYS=14

# Optional AI re-ranking. Gemini is preferred; Anthropic is the fallback provider.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
