# KUBO API
APP_ENV=development
PORT=3001
DB_PATH=kubo.db
DB_SYNCHRONIZE=true

# Supabase Postgres. When DATABASE_URL is set, it replaces DB_PATH.
# Use the Session pooler (port 5432) locally and Transaction pooler (port 6543)
# when the API is deployed to a serverless platform such as Vercel.
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_SIZE=1

# Supabase server client and private Storage.
# Use SUPABASE_SECRET_KEY for new projects or the legacy service-role key.
# Never expose either server key in frontend code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_SIGNED_URL_TTL_SECONDS=300
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000

# Document Intelligence
# Use gemini for serverless deployment; use docling for the Docker service.
DOCUMENT_PARSER_PROVIDER=gemini
# Local Docker Compose exposes the adapter on port 8000.
DOCUMENT_INTELLIGENCE_URL=http://localhost:8000
DOCUMENT_INTELLIGENCE_TIMEOUT_MS=300000
DOCUMENT_TEMPLATE_DIR=uploads/documents/templates

# Durable serverless document jobs. API_BASE_URL is the deployed backend URL.
API_BASE_URL=
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Live vessel tracking. Keep secrets only in .env; never commit real keys here.
AISSTREAM_API_KEY=
AISSTREAM_ENABLED=false
AISSTREAM_WATCHDOG_TIMEOUT_MS=60000
AISSTREAM_RATE_LIMIT_COOLDOWN_MS=300000

# Development-only fallback. Requires APP_ENV=development or test.
# Creates clearly-labelled, non-AIS candidates for matching/order/document/OCR testing.
MATCHING_FIXTURE_ENABLED=false
MATCHING_FIXTURE_DEPARTURE_DAYS=14
MATCHING_FIXTURE_FORWARDER_EMAIL=forwarder@kubo.dev
MATCHING_FIXTURE_FORWARDER_PASSWORD=Password123!

# Optional AI re-ranking. Gemini is preferred; Anthropic is the fallback provider.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_OCR_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
